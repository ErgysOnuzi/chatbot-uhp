# Kopjoje këtë skedar si .env dhe plotësoji vlerat.
# MOS e ngarko .env në GitHub (është në .gitignore).

# ---------- Modeli gjuhësor ----------
# Tani: DeepSeek (kontrollo emrin aktual të modelit te https://api-docs.deepseek.com)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-vendos-celesin-tend-ketu
LLM_MODEL=deepseek-flash

# Më vonë: Ollama lokal (hiq # dhe vendos # te tri rreshtat më lart)
# Brenda Docker përdor http://ollama:11434/v1, jashtë Docker http://localhost:11434/v1
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b

LLM_TEMPERATURE=0.2

# ---------- Baza e të dhënave ----------
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=ndrysho-fjalekalimin-e-db
POSTGRES_DB=chatbot
# Për zhvillim lokal pa Docker (backend jashtë Docker, db në Docker):
DATABASE_URL=postgresql+psycopg://chatbot:ndrysho-fjalekalimin-e-db@localhost:5432/chatbot

# ---------- Paneli i administratës ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ndrysho-kete-fjalekalim
# Gjenero një vlerë të rastit: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ndrysho-kete-me-nje-vlere-te-gjate

# ---------- Siguria ----------
# Adresat nga të cilat lejohet frontend-i (presje mes tyre)
CORS_ORIGINS=http://localhost:5173,http://localhost
RATE_LIMIT_PER_MINUTE=10

# ---------- RAG (opsionale) ----------
# TOP_K=5
# MAX_DISTANCE=0.65
